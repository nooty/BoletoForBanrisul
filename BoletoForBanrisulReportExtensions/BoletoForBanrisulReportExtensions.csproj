<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<DebugType>embedded</DebugType>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_").Replace("Report", ".Report").Replace("Extensions", ".Extensions"))</RootNamespace>
    <PackageId>$(AssemblyName.Replace(" ", "_").Replace("Report", ".Report").Replace("Extensions", ".Extensions"))</PackageId>
    <Title>$(AssemblyName.Replace(" ", "_").Replace("Report", ".Report").Replace("Extensions", ".Extensions"))</Title>
    <Authors>Nooty</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/nooty/BoletoForBanrisul</RepositoryUrl>
    <PackageProjectUrl>https://github.com/nooty/BoletoForBanrisul</PackageProjectUrl>
    <Description>Allows integration of the BoletoForBanrisul.Report component with the .NET dependency injection container.</Description>
    <Product>$(AssemblyName.Replace(" ", "_").Replace("Report", ".Report").Replace("Extensions", ".Extensions"))</Product>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Version>1.0.0-rc.5</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BoletoForBanrisulReport\BoletoForBanrisulReport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>

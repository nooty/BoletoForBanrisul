<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
	<LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
	<DebugType>embedded</DebugType>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_").Replace("Client", ".Client"))</RootNamespace>
    <PackageId>$(AssemblyName.Replace("Client", ".Client"))</PackageId>
    <Title>$(AssemblyName.Replace("Client", ".Client"))</Title>
    <Authors>Wendell Gasparoni</Authors>
    <Product>$(AssemblyName.Replace("Client", ".Client"))</Product>
    <Description>The BoletoForBanrisul.Client component is a .NET client that provides full integration with Banrisul's billing API.

Key features:

1. Register boletos
2. Consult boletos
3. Change due dates
4. Grant abatements
5. Cancel boletos
6. Issue boletos in PDF format

The component also manages the OAuth2 authentication process. Returned tokens are cached for reuse, making it easier to interact with the billing API.

For local export of boletos in PDF format, use the complementary component BoletoForBanrisul.Report.

This is an independent, community project. It is not affiliated with, endorsed by, or supported by Banco do Estado do Rio Grande do Sul (Banrisul). Using the API requires credentials the bank issues to your organization.</Description>
    <PackageTags>boleto banrisul cobranca febraban banco-041 api oauth2</PackageTags>
    <PackageProjectUrl>https://github.com/nooty/BoletoForBanrisul</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nooty/BoletoForBanrisul</RepositoryUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <!-- CS1591: the XML doc file still ships, so the summaries that exist reach consumers; the
         members without one do not fail the build. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
	<Version>1.0.0-rc.10</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\UrlSettings.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\UrlSettings.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BoletoForBanrisulCore\BoletoForBanrisulCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BoletoForBanrisul.Client.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
    <PackageReference Include="Polly" Version="8.4.2" />
    <PackageReference Include="Polly.Contrib.WaitAndRetry" Version="1.1.1" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
    <PackageReference Include="StandardSocketsHttpHandler" Version="2.2.0.8" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>

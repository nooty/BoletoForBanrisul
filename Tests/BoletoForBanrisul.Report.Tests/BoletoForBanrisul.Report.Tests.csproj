<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The three shipping libraries target netstandard2.0; tests run on a real framework instead, and
         requiring an XML doc comment on every [Fact] would only add noise. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />

    <!-- The Report project itself only references the Abstractions package (IServiceCollection); the
         concrete ServiceCollection/BuildServiceProvider used by ReportExtensionsTest live in the full
         package, so it is referenced directly here rather than relying on a transitive version. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />

    <!-- Not used directly: it lifts Caching.Memory 6.0.0 (GHSA-qj66-m88j-hmgj) to a patched version.
         RazorLight asks for 2.1.0 under netstandard2.0, which the Report package resolves and is not
         affected; only these net10.0 test projects land on the vulnerable 6.0.0. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BoletoForBanrisulCore\BoletoForBanrisulCore.csproj" />
    <ProjectReference Include="..\..\BoletoForBanrisulReport\BoletoForBanrisulReport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

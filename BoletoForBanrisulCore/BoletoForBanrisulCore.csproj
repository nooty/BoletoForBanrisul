<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <RootNamespace>BoletoForBanrisul.Core</RootNamespace>
    <PackageId>BoletoForBanrisul.Core</PackageId>
    <Title>BoletoForBanrisul.Core</Title>
    <Authors>Wendell Gasparoni</Authors>
    <Product>BoletoForBanrisul.Core</Product>
    <Description>BoletoForBanrisul.Core carries what BoletoForBanrisul.Client and BoletoForBanrisul.Report share: the boleto model, its JSON contract with Banrisul's billing API, and the calculations a boleto needs.

Key features:

1. Boleto models mirroring the bank's payloads, with JSON converters for its formats
2. Local validation of a boleto before it is sent, reporting every offending field at once
3. CPF and CNPJ check digit validation
4. Barcode and linha digitável computation, following the FEBRABAN standard

Install it on its own only to use the models, the validator and the calculations: BoletoForBanrisul.Client and BoletoForBanrisul.Report already bring it in.

This is an independent, community project. It is not affiliated with, endorsed by, or supported by Banco do Estado do Rio Grande do Sul (Banrisul).</Description>
    <PackageTags>boleto banrisul cobranca febraban banco-041 models validation</PackageTags>
    <PackageProjectUrl>https://github.com/nooty/BoletoForBanrisul</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nooty/BoletoForBanrisul</RepositoryUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <!-- CS1591: the XML doc file still ships, so the summaries that exist reach consumers; the
         members without one do not fail the build. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Version>1.0.0-rc.12</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="MiniValidation" Version="0.10.0" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <RootNamespace>BoletoForBanrisul.Core</RootNamespace>
    <PackageId>BoletoForBanrisul.Core</PackageId>
    <Title>BoletoForBanrisul.Core</Title>
    <Authors>Nooty</Authors>
    <Product>BoletoForBanrisul.Core</Product>
    <Description>Shared boleto models, helpers and JSON converters used by BoletoForBanrisul.Client and BoletoForBanrisul.Report.</Description>
    <PackageProjectUrl>https://github.com/nooty/BoletoForBanrisul</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nooty/BoletoForBanrisul</RepositoryUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Version>1.0.0-rc.5</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>

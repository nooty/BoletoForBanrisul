@using RazorLight
@using BoletoForBanrisul.Report.Helpers
@using BoletoForBanrisul.Core.Helpers
@inherits TemplatePage<BoletoForBanrisul.Report.ViewModels.PrintViewModel>
@{
    var Boleto = Model.Boleto;
    var Beneficiary = Model.Beneficiary;
}

<html>
<head>
    <title></title>
    <meta charset="UTF-8">
    <style>
        body {
            font-family: Arial;
        }

        td.boleto-bank-code {
            font-size: 6mm;
            font-weight: bold;
            font-style: italic;
            text-align: center;
            vertical-align: bottom;
            border-bottom: 0.30mm solid #000000;
            border-right: 0.30mm solid #000000;
            padding-bottom: 1mm
        }

        td.boleto-logo {
            border-bottom: 0.30mm solid #000000;
            border-right: 0.30mm solid #000000;
            text-align: center;
            height: 10mm
        }

            td.boleto-logo img {
                max-height: 6mm
            }

        td.highlight {
            background-color: #d3d3d3;
        }

        td div.boleto-bank-info {
            font-weight: bold;
            border-bottom: 0.30mm solid #000000;
            padding-bottom: 1mm;
            text-align: right;
            height: 10mm;
            display: flex;
            justify-items: right;
            align-items: center;
            flex-direction: row;
            justify-content: space-between;
        }

            td div.boleto-bank-info .contact {
                width: 60mm; 
                font-size: 2.5mm;
            }

            td div.boleto-bank-info .title {
                font-size: 4mm;
            }

        td.boleto-digitable-line {
            font-size: 4mm;
            font-weight: bold;
            text-align: right;
            vertical-align: bottom;
            border-bottom: 0.30mm solid #000000;
            padding-bottom: 1mm;
        }

            td.boleto-digitable-line span {
                font-size: 2mm;
            }

        td.boleto-right-title {
            font-size: 0.2cm;
            padding-left: 0.15mm;
            border-right: 0.30mm solid #000000;
            text-align: left;
            padding-left: 1mm;
        }

        td.boleto-left-title {
            font-size: 2mm;
            padding-left: 0.15mm;
            text-align: left;
            padding-left: 1mm;
        }

        td.boleto-right-value {
            font-size: 3mm;
            text-align: center;
            border-right: 0.30mm solid #000000;
            border-right: 0.30mm solid #000000;
            font-weight: bold;
            border-bottom: 0.30mm solid #000000;
            padding-top: 0.5mm
        }

        td.pix {
            text-align: center;
            vertical-align: central;
        }

            td.pix img {
                height: 25mm;
                width: 25mm;
                max-height: 25mm;
                max-width: 25mm;
                padding-bottom: 1mm;
            }

        td.boleto-right-value-no-separation {
            font-size: 3mm;
            text-align: center;
            font-weight: bold;
            border-bottom: 0.30mm solid #000000;
            padding-top: 0.5mm
        }

        td.boleto-left-value {
            font-size: 3mm;
            text-align: right;
            padding-right: 3mm;
            padding-top: 0.8mm;
            border-bottom: 0.30mm solid #000000;
            font-weight: bold;
        }

        td.boleto-payer-title {
            font-size: 2mm;
            padding-left: 0.15mm;
            vertical-align: top;
            padding-top: 0.15mm;
            text-align: left;
            padding-left: 1mm;
        }

        td.boleto-payer-value {
            font-size: 2.5mm;
            font-weight: bold;
            text-align: left;
            vertical-align: top;
            height: 10mm;
        }

        td.boleto-payee-title {
            font-size: 2mm;
            vertical-align: bottom;
            text-align: left;
            padding-bottom: 0.8mm;
            border-bottom: 0.30mm solid #000000;
            padding-left: 1mm;
        }

        td.boleto-payee-value {
            font-size: 2.5mm;
            vertical-align: bottom;
            padding-bottom: 0.15mm;
            border-bottom: 0.30mm solid #000000;
            font-weight: bold;
            text-align: left
        }

        td.boleto-dotted-line {
            border-top: 0.3mm dashed #000000;
            font-size: 1mm
        }

        ul.boleto-instructions {
            font-size: 3mm;
            display: none;
        }

        td.barcode {
            text-align: left;
            padding-left: 5mm;
            padding-bottom: 1mm;
        }

            td.barcode img {
                width: 103mm;
                height: 13mm;
                max-width: 103mm;
                max-height: 13mm;
            }

        td .message {
            margin-bottom: 1.5mm;
        }
    </style>
</head>
<body>
    <div align="center">
        <table cellspacing="0" cellpadding="0" border="0" class="Boleto">
            <tbody>
                <tr>
                    <td style="width: 0.9cm"></td>
                    <td style="width: 1cm"></td>
                    <td style="width: 1.9cm"></td>

                    <td style="width: 0.5cm"></td>
                    <td style="width: 1.3cm"></td>
                    <td style="width: 0.8cm"></td>
                    <td style="width: 1cm"></td>

                    <td style="width: 1.9cm"></td>
                    <td style="width: 1.9cm"></td>

                    <td style="width: 3.8cm"></td>

                    <td style="width: 3.8cm"></td>
                </tr>
                <tr>
                    <td colspan="11">
                        <ul class="boleto-instructions">
                            <li>Imprima em papel A4 ou Carta</li>
                            <li>Utilize margens mínimas a direita e a esquerda</li>
                            <li>Recorte na linha pontilhada</li>
                            <li>Não rasure o código de barras</li>
                        </ul>
                    </td>
                </tr>

                <tr><td colspan="11" class="boleto-dotted-line">&nbsp;</td></tr>
                <tr>
                    <td colspan="4" class="boleto-logo"><img src="@Model.LogoPath"></td>
                    <td colspan="2" class="boleto-bank-code">041-8</td>
                    <td colspan="5" >
                        <div class="boleto-bank-info">
                            <span class="contact"> SAC BANRISUL 0800-646-1515<br />OUVIDORIA BANRISUL 0800-644-2200</span>
                            <span class="title">Recibo do Pagador</span>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="10" class="boleto-right-title">Local de Pagamento</td>
                    <td class="boleto-left-title highlight">Vencimento</td>
                </tr>
                <tr>
                    <td colspan="10" class="boleto-right-value" style="text-align: left; padding-left : 0.1cm">@Model.PaymentLocation</td>
                    <td class="boleto-left-value highlight">@Boleto.Titulo.DataVencimento.ToString("dd/MM/yyyy")</td>
                </tr>
                <tr>
                    <td colspan="10" class="boleto-right-title">Beneficiário</td>
                    <td class="boleto-left-title">Agência/Código do Beneficiário</td>
                </tr>
                <tr>
                    <td colspan="10" class="boleto-right-value" style="text-align: left; padding-left : 0.1cm">
                        @Beneficiary.Name, CNPJ/CPF @CnpjCpfHelper.Format(Beneficiary.CpfCnpj),
                        @Beneficiary.Address, @Beneficiary.City - @Beneficiary.State, CEP @ZipCodeHelper.Format(Beneficiary.ZipCode)
                    </td>
                    <td class="boleto-left-value">@BeneficiaryHelper.Format(@Beneficiary.Code)</td>
                </tr>
                <tr>
                    <td colspan="3" class="boleto-right-title">Data do Documento</td>
                    <td colspan="4" class="boleto-right-title">Número do Documento</td>
                    <td class="boleto-right-title">Espécie</td>
                    <td class="boleto-right-title">Aceite</td>
                    <td class="boleto-right-title">Data do Processamento</td>
                    <td class="boleto-left-title">Nosso Número</td>
                </tr>
                <tr>
                    <td colspan="3" class="boleto-right-value">@Boleto.Titulo.DataEmissao.ToString("dd/MM/yyyy")</td>
                    <td colspan="4" class="boleto-right-value">@Boleto.Titulo.SeuNumero</td>
                    <td class="boleto-right-value">@BoletoTypeHelper.GetAbbreviation(Boleto.Titulo.Especie)</td>
                    <td class="boleto-right-value">@AcceptanceHelper.GetAbbreviation(Boleto.Titulo.Pagador.Aceite)</td>
                    <td class="boleto-right-value">@Boleto.Titulo.DataEmissao.ToString("dd/MM/yyyy")</td>
                    <td class="boleto-left-value">@Boleto.Titulo.NossoNumero</td>
                </tr>
                <tr>
                    <td colspan="3" class="boleto-right-title">Uso do Banco</td>
                    <td colspan="2" class="boleto-right-title">Carteira</td>
                    <td colspan="2" class="boleto-right-title">Moeda</td>
                    <td colspan="2" class="boleto-right-title">Quantidade</td>
                    <td class="boleto-right-title">(x) Valor</td>
                    <td class="boleto-left-title highlight">(=) Valor do Documento</td>
                </tr>
                <tr>
                    <td colspan="3" class="boleto-right-value">&nbsp;</td>
                    <td colspan="2" class="boleto-right-value">@WalletTypeHelper.GetAbbreviation(Boleto.Titulo.Carteira)</td>
                    <td colspan="2" class="boleto-right-value">R$</td>
                    <td colspan="2" class="boleto-right-value">&nbsp;</td>
                    <td class="boleto-right-value">&nbsp;</td>
                    <td class="boleto-left-value highlight">@CurrencyHelper.Format(Boleto.Titulo.ValorNominal)</td>
                </tr>
                <tr>
                    <td colspan="10" class="boleto-right-title">Instruções</td>
                    <td class="boleto-left-title">(-) Desconto</td>
                </tr>
                @if (string.IsNullOrEmpty(Model.QRCode))
                {
                    <tr>
                        <td colspan="10" rowspan="9" class="boleto-right-value instrucoes" style="text-align: left; vertical-align:top; padding-left : 0.1cm">
                            @{
                                await IncludeAsync("Messages.cshtml", Boleto);
                            }
                        </td>
                        <td class="boleto-left-value">&nbsp;</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="9" rowspan="9" class="boleto-right-value-no-separation instrucoes" style="text-align: left; vertical-align:top; padding-left : 0.1cm">
                            @{
                                await IncludeAsync("Messages.cshtml", Boleto);
                            }
                        </td>
                        <td colspan="1" rowspan="9" class="boleto-right-value pix">
                            <img src="@Model.QRCode" /><br />Pagar com PIX
                        </td>
                        <td class="boleto-left-value">&nbsp;</td>
                    </tr>
                }
                <tr>
                    <td class="boleto-left-title">(-) Outras Deduções/Abatimento</td>
                </tr>
                <tr>
                    <td class="boleto-left-value">&nbsp;</td>
                </tr>
                <tr>
                    <td class="boleto-left-title">(+) Mora/Multa/Juros</td>
                </tr>
                <tr>
                    <td class="boleto-left-value">&nbsp;</td>
                </tr>
                <tr>
                    <td class="boleto-left-title">(+) Outros Acréscimos</td>
                </tr>
                <tr>
                    <td class="boleto-left-value">&nbsp;</td>
                </tr>
                <tr>
                    <td class="boleto-left-title highlight">(=) Valor Cobrado</td>
                </tr>
                <tr>
                    <td class="boleto-left-value highlight">&nbsp;</td>
                </tr>
                <tr>
                    <td colspan="2" class="boleto-payer-title">Pagador:</td>
                    <td colspan="7" class="boleto-payer-value">
                        @Boleto.Titulo.Pagador.Nome<br>
                        @Boleto.Titulo.Pagador.Endereco, @Boleto.Titulo.Pagador.Cidade - @Boleto.Titulo.Pagador.Uf,
                        CEP @ZipCodeHelper.Format(Boleto.Titulo.Pagador.Cep)
                    </td>
                    <td colspan="2" class="boleto-payer-value">CNPJ/CPF @CnpjCpfHelper.Format(Boleto.Titulo.Pagador.CpfCnpj)</td>
                </tr>
                <tr>
                    <td colspan="2" class="boleto-payee-title">Sacador/Avalista:</td>
                    <td colspan="9" class="boleto-payee-value sacador">
                        @Boleto.Titulo.Sacador?.Nome &nbsp; &nbsp; &nbsp;
                        CNPJ/CPF @CnpjCpfHelper.Format(Boleto.Titulo.Sacador?.CpfCnpj)
                    </td>
                </tr>
                <tr>
                    <td colspan="11" class="boleto-left-title" style="text-align: right; padding-right: 0.1cm">Autenticação Mecânica</td>
                </tr>

                <!-- ******************************************** -->
                <!-- Autenticação Mecânica - FICHA DE COMPENSAÇÃO -->
                <!-- ******************************************** -->

                <tr>
                    <td colspan="11" height="200" valign="top">&nbsp;</td>
                </tr>
                <tr><td colspan="11" class="boleto-dotted-line">&nbsp;</td></tr>
                <tr>
                    <td colspan="4" class="boleto-logo"><img src="@Model.LogoPath"></td>
                    <td colspan="2" class="boleto-bank-code">041-8</td>
                    <td colspan="5" class="boleto-digitable-line">@Model.DigitableLine</td>
                </tr>
                <tr>
                    <td colspan="10" class="boleto-right-title">Local de Pagamento</td>
                    <td class="boleto-left-title highlight">Vencimento</td>
                </tr>
                <tr>
                    <td colspan="10" class="boleto-right-value" style="text-align: left; padding-left : 0.1cm">@Model.PaymentLocation</td>
                    <td class="boleto-left-value highlight">@Boleto.Titulo.DataVencimento.ToString("dd/MM/yyyy")</td>
                </tr>
                <tr>
                    <td colspan="10" class="boleto-right-title">Beneficiário</td>
                    <td class="boleto-left-title">Agência/Código do Beneficiário</td>
                </tr>
                <tr>
                    <td colspan="10" class="boleto-right-value" style="text-align: left; padding-left : 0.1cm">
                        @Beneficiary.Name, CNPJ/CPF @CnpjCpfHelper.Format(Beneficiary.CpfCnpj),
                        @Beneficiary.Address, @Beneficiary.City - @Beneficiary.State, CEP @ZipCodeHelper.Format(Beneficiary.ZipCode)
                    </td>
                    <td class="boleto-left-value">@BeneficiaryHelper.Format(@Beneficiary.Code)</td>
                </tr>
                <tr>
                    <td colspan="3" class="boleto-right-title">Data do Documento</td>
                    <td colspan="4" class="boleto-right-title">Número do Documento</td>
                    <td class="boleto-right-title">Espécie</td>
                    <td class="boleto-right-title">Aceite</td>
                    <td class="boleto-right-title">Data do Processamento</td>
                    <td class="boleto-left-title">Nosso Número</td>
                </tr>
                <tr>
                    <td colspan="3" class="boleto-right-value">@Boleto.Titulo.DataEmissao.ToString("dd/MM/yyyy")</td>
                    <td colspan="4" class="boleto-right-value">@Boleto.Titulo.SeuNumero</td>
                    <td class="boleto-right-value">@BoletoTypeHelper.GetAbbreviation(Boleto.Titulo.Especie)</td>
                    <td class="boleto-right-value">@AcceptanceHelper.GetAbbreviation(Boleto.Titulo.Pagador.Aceite)</td>
                    <td class="boleto-right-value">@Boleto.Titulo.DataEmissao.ToString("dd/MM/yyyy")</td>
                    <td class="boleto-left-value">@Boleto.Titulo.NossoNumero</td>
                </tr>
                <tr>
                    <td colspan="3" class="boleto-right-title">Uso do Banco</td>
                    <td colspan="2" class="boleto-right-title">Carteira</td>
                    <td colspan="2" class="boleto-right-title">Moeda</td>
                    <td colspan="2" class="boleto-right-title">Quantidade</td>
                    <td class="boleto-right-title">(x) Valor</td>
                    <td class="boleto-left-title highlight">(=) Valor do Documento</td>
                </tr>
                <tr>
                    <td colspan="3" class="boleto-right-value">&nbsp;</td>
                    <td colspan="2" class="boleto-right-value">@WalletTypeHelper.GetAbbreviation(Boleto.Titulo.Carteira)</td>
                    <td colspan="2" class="boleto-right-value">R$</td>
                    <td colspan="2" class="boleto-right-value">&nbsp;</td>
                    <td class="boleto-right-value">&nbsp;</td>
                    <td class="boleto-left-value highlight">@CurrencyHelper.Format(Boleto.Titulo.ValorNominal)</td>
                </tr>
                <tr>
                    <td colspan="10" class="boleto-right-title">Instruções</td>
                    <td class="boleto-left-title">(-) Desconto</td>
                </tr>
                @if (string.IsNullOrEmpty(Model.QRCode))
                {
                    <tr>
                        <td colspan="10" rowspan="9" class="boleto-right-value instrucoes" style="text-align: left; vertical-align:top; padding-left : 0.1cm">
                            @{
                                await IncludeAsync("Messages.cshtml", Boleto);
                            }
                        </td>
                        <td class="boleto-left-value">&nbsp;</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="9" rowspan="9" class="boleto-right-value-no-separation instrucoes" style="text-align: left; vertical-align:top; padding-left : 0.1cm">
                            @{
                                await IncludeAsync("Messages.cshtml", Boleto);
                            }
                        </td>
                        <td colspan="1" rowspan="9" class="boleto-right-value pix">
                            <img src="@Model.QRCode" /><br />Pagar com PIX
                        </td>
                        <td class="boleto-left-value">&nbsp;</td>
                    </tr>
                }
                <tr>
                    <td class="boleto-left-title">(-) Outras Deduções/Abatimento</td>
                </tr>
                <tr>
                    <td class="boleto-left-value">&nbsp;</td>
                </tr>
                <tr>
                    <td class="boleto-left-title">(+) Mora/Multa/Juros</td>
                </tr>
                <tr>
                    <td class="boleto-left-value">&nbsp;</td>
                </tr>
                <tr>
                    <td class="boleto-left-title">(+) Outros Acréscimos</td>
                </tr>
                <tr>
                    <td class="boleto-left-value">&nbsp;</td>
                </tr>
                <tr>
                    <td class="boleto-left-title highlight">(=) Valor Cobrado</td>
                </tr>
                <tr>
                    <td class="boleto-left-value highlight">&nbsp;</td>
                </tr>
                <tr>
                    <td colspan="2" class="boleto-payer-title">Pagador:</td>
                    <td colspan="7" class="boleto-payer-value">
                        @Boleto.Titulo.Pagador.Nome<br>
                        @Boleto.Titulo.Pagador.Endereco, @Boleto.Titulo.Pagador.Cidade - @Boleto.Titulo.Pagador.Uf,
                        CEP @ZipCodeHelper.Format(Boleto.Titulo.Pagador.Cep)
                    </td>
                    <td colspan="2" class="boleto-payer-value">CNPJ/CPF @CnpjCpfHelper.Format(Boleto.Titulo.Pagador.CpfCnpj)</td>
                </tr>
                <tr>
                    <td colspan="2" class="boleto-payee-title">Sacador/Avalista:</td>
                    <td colspan="9" class="boleto-payee-value sacador">
                        @Boleto.Titulo.Sacador?.Nome &nbsp; &nbsp; &nbsp;
                        CNPJ/CPF @CnpjCpfHelper.Format(Boleto.Titulo.Sacador?.CpfCnpj)
                    </td>
                </tr>
                <tr>
                    <td colspan="11" class="boleto-left-title" style="text-align: right; padding-right: 0.1cm">Autenticação Mecânica - FICHA DE COMPENSAÇÃO</td>
                </tr>
                <tr>
                    <td colspan="11" class="barcode"><img src="@Model.Barcode"></td>
                </tr>
                <tr><td colspan="11" class="boleto-dotted-line">&nbsp;</td></tr>
            </tbody>
        </table>
    </div>
</body>
</html>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>netstandard2.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<LangVersion>latest</LangVersion>
	<DebugType>embedded</DebugType>
	<Nullable>enable</Nullable>
	<RootNamespace>$(MSBuildProjectName.Replace(" ", "_").Replace("Report", ".Report"))</RootNamespace>
	<Title>$(AssemblyName.Replace("Report", ".Report"))</Title>
	<Authors>Wendell Gasparoni</Authors>
	<Product>$(AssemblyName.Replace("Report", ".Report"))</Product>
	<PackageProjectUrl>https://github.com/nooty/BoletoForBanrisul</PackageProjectUrl>
	<RepositoryUrl>https://github.com/nooty/BoletoForBanrisul</RepositoryUrl>
	<Description>BoletoForBanrisul.Report is a .NET component that allows the export of boletos in PDF format.

Key features:

1. Generation of boletos in PDF format
2. Generation of a zip file containing generated boleto PDFs
3. Cancellable conversions, with a hard deadline that kills a wedged browser
4. A disposable Chromium profile per conversion and a free disk space pre-check, so a full disk fails fast instead of hanging

This package uses shared boleto models from BoletoForBanrisul.Core.

Notes:
The component uses the ChromeHtmlToPdf package to generate boleto PDFs via headless Chrome/Chromium. A compatible Chrome or Chromium installation must be available in the execution environment.

This is an independent, community project. It is not affiliated with, endorsed by, or supported by Banco do Estado do Rio Grande do Sul (Banrisul).</Description>
	<PackageTags>boleto banrisul cobranca febraban banco-041 pdf chromium</PackageTags>
	<PackageLicenseFile>LICENSE</PackageLicenseFile>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageId>$(AssemblyName.Replace("Report", ".Report"))</PackageId>
	<GenerateDocumentationFile>True</GenerateDocumentationFile>
	<!-- CS1591: the XML doc file still ships, so the summaries that exist reach consumers; the
	     members without one do not fail the build. -->
	<NoWarn>$(NoWarn);1591</NoWarn>
	<Version>1.0.0-rc.12</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Banrisul.png" />
    <None Remove="Resources\Boleto.cshtml" />
    <None Remove="Resources\Messages.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Banrisul.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Boleto.cshtml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Messages.cshtml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BoletoForBanrisulCore\BoletoForBanrisulCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BoletoForBanrisul.Report.Tests" />
    <InternalsVisibleTo Include="BoletoForBanrisul.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
    <!-- Transitive through ChromeHtmlToPdf, but declared explicitly because ILogger is part of the
         public API, via ChromiumConverterSettings.Logger. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    <PackageReference Include="ChromeHtmlToPdf" Version="4.4.5" />
    <PackageReference Include="RazorLight" Version="2.3.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <!-- None is used directly: these are declared only to lift vulnerable transitive versions to
         patched ones, for this package and for whoever installs it. Drop each once the dependency
         that drags it in ships a version that already resolves past it.
         AngleSharp < 1.5.0 (GHSA-pgww-w46g-26qg), through ChromeHtmlToPdf -> HtmlSanitizer.
         Microsoft.Extensions.Caching.Memory 6.0.0 (GHSA-qj66-m88j-hmgj), through RazorLight.
         System.Text.RegularExpressions 4.3.0 (GHSA-cmhx-cq75-c4mj), through RazorLight ->
         Microsoft.CodeAnalysis.Common -> System.Xml.ReaderWriter. -->
    <PackageReference Include="AngleSharp" Version="1.5.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

</Project>

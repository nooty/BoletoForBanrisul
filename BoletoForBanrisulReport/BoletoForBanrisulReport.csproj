<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>netstandard2.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<LangVersion>latest</LangVersion>
	<DebugType>embedded</DebugType>
	<Nullable>enable</Nullable>
	<RootNamespace>$(MSBuildProjectName.Replace(" ", "_").Replace("Report", ".Report"))</RootNamespace>
	<Title>$(AssemblyName.Replace("Report", ".Report"))</Title>
	<Authors>Wendell Gasparoni</Authors>
	<Product>$(AssemblyName.Replace("Report", ".Report"))</Product>
	<PackageProjectUrl>https://github.com/nooty/BoletoForBanrisul</PackageProjectUrl>
	<RepositoryUrl>https://github.com/nooty/BoletoForBanrisul</RepositoryUrl>
	<Description>BoletoForBanrisul.Report is a .NET component that allows the export of boletos in PDF format.

Key features:

1. Generation of boletos in PDF format
2. Generation of a zip file containing generated boleto PDFs

This package uses shared boleto models from BoletoForBanrisul.Core.

Notes:
The component uses the ChromiumHtmlToPdfLib library to generate boleto PDFs via headless Chrome/Chromium. A compatible Chrome or Chromium installation must be available in the execution environment.</Description>
	<PackageLicenseFile>LICENSE</PackageLicenseFile>
	<PackageId>$(AssemblyName.Replace("Report", ".Report"))</PackageId>
	<GenerateDocumentationFile>True</GenerateDocumentationFile>
	<Version>1.0.0-rc.6</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Banrisul.png" />
    <None Remove="Resources\Boleto.cshtml" />
    <None Remove="Resources\Messages.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Banrisul.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Boleto.cshtml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Messages.cshtml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BoletoForBanrisulCore\BoletoForBanrisulCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <!-- Transitivo pelo ChromeHtmlToPdf, mas explicitado porque ILogger agora faz parte da API
         pública, via ChromiumConverterSettings.Logger. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="ChromeHtmlToPdf" Version="4.2.10" />
    <PackageReference Include="RazorLight" Version="2.3.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.7" />
    <PackageReference Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.14" />
  </ItemGroup>

</Project>
